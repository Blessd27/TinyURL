@{
    ViewData["Title"] = "Privacy Policy";
}
<div class="content-card">
    <h1>@ViewData["Title"]</h1>
    <p>
        TinyURL is a lightweight, in-memory demonstration project. It does not use a
        database, does not require an account, and does not persist any data beyond
        the current run of the application &mdash; all shortened links are lost when
        the application restarts.
    </p>
</div>
